#!/usr/bin/env bash
# roost — make a Linux/WSL machine your always-reachable dev box.
set -uo pipefail

ROOST_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export ROOST_HOME
# shellcheck source=../lib/common.sh
source "$ROOST_HOME/lib/common.sh"

ROOST_VERSION="0.1.0-dev"

usage() {
  cat <<EOF
roost $ROOST_VERSION — your dev box, reachable from anywhere

  roost init [--role box|client] [--name NAME] [--box NAME] [--rc-dir DIR] [--yes]
                    set up this machine (safe to re-run; it fixes only what's missing)
  roost doctor      check everything, change nothing
  roost status      this machine, your tailnet devices, Remote Control
  roost attach      open your persistent terminal (on the box, over SSH if you're on a client)
  roost rc attach|logs|restart|stop
                    the always-on Claude Remote Control service (box only)

Roles:
  box     the machine that runs your work 24/7 — home PC (WSL), VPS, Raspberry Pi
  client  a laptop you connect from; it keeps working on its own if the box is down
EOF
}

# ---------- step runner ----------
# run_step <file> <mode: check|init>  → 0 ok, 1 broken, 2 manual action pending, 3 stop (restart needed), 4 skipped
run_step() {
  local file="$1" mode="$2"
  (
    STEP_ROLES="box client"; STEP_WSL_ONLY=0; STEP_MANUAL=0; STEP_DETAIL=""
    # shellcheck disable=SC1090
    source "$file"
    [[ " $STEP_ROLES " == *" $ROLE "* ]] || exit 4
    if [[ "$STEP_WSL_ONLY" == 1 ]] && ! is_wsl; then exit 4; fi

    if step_check; then ok "$(step_title)"; exit 0; fi

    if [[ "$STEP_MANUAL" == 1 ]]; then
      warn "$(step_title)  ${C_YELLOW}[your action]${C_RESET}"
      step_manual
      exit 2
    fi

    bad "$(step_title)"
    [[ -n "$STEP_DETAIL" ]] && hint "$STEP_DETAIL"
    [[ "$mode" == check ]] && exit 1

    ask "Fix this now?" y || exit 1
    step_apply; rc=$?
    [[ $rc == 3 ]] && exit 3
    STEP_DETAIL=""
    if step_check; then ok "fixed"; exit 0; fi
    bad "still not right${STEP_DETAIL:+: $STEP_DETAIL}"
    exit 1
  )
}

run_all() {
  local mode="$1" f rc n_ok=0 n_bad=0 n_manual=0
  for f in "$ROOST_HOME"/lib/steps/*.sh; do
    run_step "$f" "$mode"; rc=$?
    case $rc in
      0) ((n_ok++)) ;;
      1) ((n_bad++)) ;;
      2) ((n_manual++)) ;;
      3) say; say "Stopped: restart needed (see above). Then run: roost init"; return 3 ;;
    esac
  done
  say
  if (( n_bad == 0 && n_manual == 0 )); then
    say "${C_GREEN}${C_BOLD}All set.${C_RESET} $n_ok checks passed."
  else
    say "$n_ok ok · ${C_RED}$n_bad to fix${C_RESET} · ${C_YELLOW}$n_manual need you${C_RESET}"
    [[ "$mode" == check ]] && (( n_bad > 0 )) && say "Run ${C_BOLD}roost init${C_RESET} to fix what can be fixed automatically."
  fi
  (( n_bad == 0 ))
}

guess_role() {
  if is_wsl; then
    # Win32_ComputerSystem.PCSystemType: 2 = mobile (laptop)
    [[ "$(win_ps '(Get-CimInstance Win32_ComputerSystem).PCSystemType')" == 2 ]] && echo client || echo box
  else
    echo box
  fi
}

cmd_init() {
  load_config
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --role) ROLE="$2"; shift 2 ;;
      --name) NAME="$2"; shift 2 ;;
      --box) BOX="$2"; shift 2 ;;
      --rc-dir) RC_DIR="$2"; shift 2 ;;
      --yes|-y) export ROOST_YES=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  head1 "roost init"
  if [[ -z "$ROLE" ]]; then
    local g; g="$(guess_role)"
    say "  What is this machine?"
    say "    ${C_BOLD}box${C_RESET}     runs your work 24/7 (home PC, VPS, Pi) — your phone connects to it"
    say "    ${C_BOLD}client${C_RESET}  a laptop you connect from"
    ROLE="$(ask_value "Role (box/client)?" "$g")"
  fi
  [[ "$ROLE" == box || "$ROLE" == client ]] || die "role must be box or client"
  if [[ -z "$NAME" ]]; then
    local def; [[ "$ROLE" == box ]] && def=devbox || def="$(hostname | tr '[:upper:]' '[:lower:]')"
    NAME="$(ask_value "Name on your private network?" "$def")"
  fi
  if [[ "$ROLE" == client && -z "$BOX" ]]; then BOX="$(ask_value "Name of your box?" devbox)"; fi
  save_config
  ok "saved $ROOST_CONFIG (role=$ROLE name=$NAME)"

  head1 "Setting up this machine as a $ROLE"
  run_all init
  local rc=$?
  if [[ $rc == 0 && "$ROLE" == box ]]; then
    say
    say "Next: on your phone open the Claude app → Code. A session named '$NAME' should be listed."
    say "      To see the Remote Control screen (QR code): roost rc attach"
  fi
  return $rc
}

cmd_doctor() {
  load_config
  [[ -n "$ROLE" ]] || { ROLE="$(guess_role)"; say "  ${C_DIM}(not set up yet — checking as a '$ROLE'; run roost init to choose)${C_RESET}"; }
  [[ -n "$NAME" ]] || NAME="$([[ $ROLE == box ]] && echo devbox || hostname | tr '[:upper:]' '[:lower:]')"
  head1 "roost doctor — role: $ROLE, name: $NAME"
  run_all check
}

cmd_status() {
  load_config
  head1 "This machine"
  say "  role: ${ROLE:-not set up}   name: ${NAME:-?}   $(is_wsl && echo "WSL distro: $(wsl_distro)")"
  if [[ "$ROLE" == box ]]; then
    say "  remote control: $(systemctl --user is-active roost-rc 2>/dev/null)"
  fi
  local ts; ts="$(tmux ls 2>/dev/null | cut -d: -f1 | paste -sd' ')"
  say "  tmux sessions: ${ts:-none}"
  head1 "Your devices (tailnet)"
  if has tailscale; then
    ts_py '"\n".join("  {:<4} {:<22} {}".format("●" if p.get("Online") else "○", p["HostName"], p["OS"]) for p in [d["Self"]] + list((d.get("Peer") or {}).values()))' \
      || say "  tailscale not connected"
  else
    say "  tailscale not installed"
  fi
}

cmd_attach() {
  load_config
  if [[ "$ROLE" == client ]]; then
    exec ssh -t "$USER@${BOX:-devbox}" 'tmux new-session -A -s main'
  fi
  exec tmux new-session -A -s main
}

cmd_rc() {
  case "${1:-}" in
    attach)  exec tmux attach -t roost-rc ;;
    logs)    exec journalctl --user -u roost-rc -n 50 --no-pager ;;
    restart) systemctl --user restart roost-rc && ok "restarted" ;;
    stop)    systemctl --user stop roost-rc && ok "stopped" ;;
    *) die "usage: roost rc attach|logs|restart|stop" ;;
  esac
}

case "${1:-}" in
  init)   shift; cmd_init "$@" ;;
  doctor) cmd_doctor ;;
  status) cmd_status ;;
  attach) cmd_attach ;;
  rc)     shift; cmd_rc "$@" ;;
  version|--version) echo "roost $ROOST_VERSION" ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
